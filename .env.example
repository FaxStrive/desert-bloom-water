# Copy to .env.local for local development, and set the same values in the
# hosting provider's environment settings for production.
#
# This seed ships with no working form endpoint on purpose. Do not fill this
# file with a placeholder key borrowed from another client's account. Get the
# client's own key, or a GoHighLevel endpoint URL made for this client.

# This client's own form provider endpoint (for example a form service's
# submission URL, issued to THIS client's own account), or:
NEXT_PUBLIC_FORM_ENDPOINT_URL=

# GoHighLevel inbound webhook URL for THIS client's location, if that is the
# lead path instead of a form provider endpoint.
NEXT_PUBLIC_GHL_ENDPOINT_URL=

# THE CLIENT'S OWN DOMAIN, set only at launch. While this is empty, or names a
# vercel.app or local host, the site is closed to search engines: robots.txt
# disallows everything and every page carries noindex, so a review deployment
# of a real client is never indexed as a duplicate. Set it to the client's real
# domain (https plus the host, no path) in the hosting provider's environment
# when the site goes live and the site opens.
NEXT_PUBLIC_SITE_URL=
